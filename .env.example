# Django Security Settings
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production-please-generate-a-new-one
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (SQLite for development)
# For production, use PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Email Settings (Development - MailHog)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@shopsphere.local

# Frontend URL (for email verification links)
FRONTEND_URL=http://127.0.0.1:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
